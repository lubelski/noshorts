{
  "manifest_version": 3,
  "name": "NoShorts",
  "version": "0.1.0",
  "description": "Less scrolling, more subscriptions. Hide YouTube Shorts and make Home open Subscriptions.",
  "minimum_chrome_version": "105",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://youtube.com/*"
      ],
      "css": [
        "hide-shorts.css"
      ],
      "js": [
        "navigation.js",
        "subscriptions.js"
      ],
      "run_at": "document_start"
    }
  ]
}
